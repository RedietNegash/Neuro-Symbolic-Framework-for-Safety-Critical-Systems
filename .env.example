# Gemini API (Free tier - limited)
GEMINI_API_KEY=your api key
GEMINI_MODEL=gemini-2.5-flash

# HuggingFace Inference API (Free tier)
HUGGINGFACE_API_KEY=your api key
HUGGINGFACE_MODEL=microsoft/phi-2

# Local Llama Configuration - UPDATED FOR YOUR SETUP
USE_LOCAL_LLAMA=true
LOCAL_LLAMA_TYPE=ollama
LLAMA_ENDPOINT=http://localhost:11434
LLAMA_MODEL=llama3:8b  # Changed from llama3.2:3b to your llama3:8b

# Framework Settings
LOG_LEVEL=INFO
MAX_ITERATIONS=5
Z3_PRECHECK_ENABLED=true
ENSEMBLE_PARALLEL=true